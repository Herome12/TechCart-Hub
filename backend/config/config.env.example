# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
database_url=mongodb://127.0.0.1:27017/Market
# For production with MongoDB Atlas, use:
# database_url=mongodb+srv://<username>:<password>@cluster.mongodb.net/Market?retryWrites=true&w=majority

# JWT Configuration
JWTkey=your_jwt_secret_key_here
JWT_expire=5d

# SMTP Email Configuration (for sending emails)
SMPT_MAIL=your_email@gmail.com
SMPT_PASSWORD=your_app_password
SMPT_SERVICE=gmail
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465

# Cloudinary Configuration (for image uploads)
cloud_name=your_cloudinary_cloud_name
api_key=your_cloudinary_api_key
api_secret=your_cloudinary_api_secret

# Stripe Payment Configuration
stripe_key=your_stripe_publishable_key
stripe_secret_key=your_stripe_secret_key
