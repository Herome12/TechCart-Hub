# TechCart Hub - Backend Environment Variables Template
# Copy this file as .env or config.env in the backend folder
# Fill in with your actual values

# ===== SERVER CONFIGURATION =====
PORT=8000

# ===== DATABASE CONFIGURATION =====
# Local MongoDB
database_url="mongodb://127.0.0.1:27017/Market"

# MongoDB Atlas (Cloud)
# database_url="mongodb+srv://username:password@cluster-name.mongodb.net/Market"

# ===== JWT CONFIGURATION =====
JWTkey="your_super_secret_jwt_key_here_change_this_value"
JWT_expire=5d
COOKIE_EXPIRE=5

# ===== EMAIL CONFIGURATION (Gmail SMTP) =====
SMPT_MAIL="your-email@gmail.com"
SMPT_PASSWORD="your-app-password-here"
# Get App Password from: https://myaccount.google.com/apppasswords
SMPT_SERVICE="gmail"
SMPT_HOST="smtp.gmail.com"
SMPT_PORT=465

# ===== CLOUDINARY CONFIGURATION =====
# Get these from: https://cloudinary.com/
cloud_name="your_cloudinary_cloud_name"
api_key="your_cloudinary_api_key"
api_secret="your_cloudinary_api_secret"

# ===== STRIPE CONFIGURATION =====
# Get these from: https://stripe.com/docs/keys
stripe_key="pk_test_your_stripe_public_key"
stripe_secret_key="sk_test_your_stripe_secret_key"

# For production, use:
# stripe_key="pk_live_your_stripe_public_key"
# stripe_secret_key="sk_live_your_stripe_secret_key"
